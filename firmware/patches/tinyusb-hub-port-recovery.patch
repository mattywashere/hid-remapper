diff --git a/src/host/usbh.c b/src/host/usbh.c
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -1297,6 +1297,9 @@
   ENUM_RESET_DELAY = 50, // USB specs: 10 to 50ms
   ENUM_CONTACT_DEBOUNCING_DELAY = 450, // when plug/unplug a device, physical connection can be bouncing and may
                                        // generate a series of attach/detach event. This delay wait for stable connection
+  // Diagnostic-only non-reset follow-up observations on a connected, disabled hub port.
+  ENUM_HUB_TRACE_RECHECK_MS = 250,
+  ENUM_HUB_TRACE_FINAL_MS = 500,
 };
 
 enum {
@@ -1304,6 +1307,8 @@
   ENUM_RESET_1,         // 1st reset when attached
   //ENUM_HUB_GET_STATUS_1,
   ENUM_HUB_CLEAR_RESET_1,
+  ENUM_HUB_TRACE_STATUS_2,
+  ENUM_HUB_TRACE_STATUS_3,
   ENUM_ADDR0_DEVICE_DESC,
   ENUM_RESET_2,         // 2nd reset before set address (not used)
   ENUM_HUB_GET_STATUS_2,
@@ -1355,23 +1360,57 @@
     #if CFG_TUH_HUB
     //case ENUM_HUB_GET_STATUS_1: break;
 
-    case ENUM_HUB_CLEAR_RESET_1: {
+    case ENUM_HUB_CLEAR_RESET_1:
+    case ENUM_HUB_TRACE_STATUS_2:
+    case ENUM_HUB_TRACE_STATUS_3: {
+      // Trace the first status after the hub driver's reset and up to two
+      // subsequent observations, WITHOUT issuing any additional resets.
       hub_port_status_response_t port_status;
-      memcpy(&port_status, _usbh_ctrl_buf, sizeof(hub_port_status_response_t));
+      memcpy(&port_status, _usbh_ctrl_buf, sizeof(port_status));
+      uint8_t const sample = (state == ENUM_HUB_CLEAR_RESET_1) ? 1 :
+                             (state == ENUM_HUB_TRACE_STATUS_2) ? 2 : 3;
+      TU_LOG1("HUBTRACE status hub=%u port=%u sample=%u status=%04x change=%04x\r\n",
+              _dev0.hub_addr, _dev0.hub_port, sample,
+              port_status.status.value, port_status.change.value);
 
       if (!port_status.status.connection) {
-        // device unplugged while delaying, nothing else to do
+        TU_LOG1("HUBTRACE disconnected hub=%u port=%u\r\n",
+                _dev0.hub_addr, _dev0.hub_port);
         enum_full_complete();
-        return;
+        break;
+      }
+
+      if (!port_status.status.port_enable) {
+        // The status is reported by the hub, not by the mouse driver.
+        // Observe whether the hub ever enables the port before changing
+        // lower-level PIO timings or attempting another reset workaround.
+        if (state != ENUM_HUB_TRACE_STATUS_3) {
+          uint32_t const delay_ms = (state == ENUM_HUB_CLEAR_RESET_1) ?
+                                    ENUM_HUB_TRACE_RECHECK_MS : ENUM_HUB_TRACE_FINAL_MS;
+          uint16_t const next_state = (state == ENUM_HUB_CLEAR_RESET_1) ?
+                                      ENUM_HUB_TRACE_STATUS_2 : ENUM_HUB_TRACE_STATUS_3;
+          osal_task_delay(delay_ms);
+          TU_ASSERT(hub_port_get_status(_dev0.hub_addr, _dev0.hub_port,
+                                        _usbh_ctrl_buf, process_enumeration, next_state),);
+        } else {
+          TU_LOG1("HUBTRACE port-never-enabled hub=%u port=%u\r\n",
+                  _dev0.hub_addr, _dev0.hub_port);
+          enum_full_complete();
+        }
+        break;
       }
 
       _dev0.speed = (port_status.status.high_speed) ? TUSB_SPEED_HIGH :
                     (port_status.status.low_speed) ? TUSB_SPEED_LOW : TUSB_SPEED_FULL;
 
-      // Acknowledge Port Reset Change
+      // Do not request the address-zero descriptor unless PORT_ENABLE is 1.
       if (port_status.change.reset) {
-        hub_port_clear_reset_change(_dev0.hub_addr, _dev0.hub_port,
-                                    process_enumeration, ENUM_ADDR0_DEVICE_DESC);
+        TU_ASSERT(hub_port_clear_reset_change(_dev0.hub_addr, _dev0.hub_port,
+                                              process_enumeration, ENUM_ADDR0_DEVICE_DESC),);
+      } else {
+        TU_LOG1("HUBTRACE enabled-but-no-reset-change hub=%u port=%u\r\n",
+                _dev0.hub_addr, _dev0.hub_port);
+        enum_full_complete();
       }
       break;
     }
