diff --git a/src/host/usbh.c b/src/host/usbh.c
index ebcee2f..d7a575d 100644
--- a/src/host/usbh.c
+++ b/src/host/usbh.c
@@ -1313,6 +1313,10 @@ enum {
   ENUM_HUB_TRACE_RESET_READBACK,
   ENUM_HUB_TRACE_CONNECTION_CLEARED,
   ENUM_HUB_TRACE_CONNECTION_READBACK,
+  ENUM_HUB_POWER_OFF,
+  ENUM_HUB_POWER_OFF_STATUS,
+  ENUM_HUB_POWER_ON,
+  ENUM_HUB_POWER_ON_STATUS,
   ENUM_ADDR0_DEVICE_DESC,
   ENUM_RESET_2,         // 2nd reset before set address (not used)
   ENUM_HUB_GET_STATUS_2,
@@ -1338,6 +1342,9 @@ static void process_enumeration(tuh_xfer_t* xfer) {
     ATTEMPT_DELAY_MS = 100
   };
   static uint8_t failed_count = 0;
+  // One attempt per boot: test whether cycling a downstream hub port's
+  // power changes its ability to establish a full-speed link.
+  static bool downstream_power_cycled = false;
 
   if (XFER_RESULT_SUCCESS != xfer->result) {
     // retry if not reaching max attempt
@@ -1463,6 +1470,59 @@ static void process_enumeration(tuh_xfer_t* xfer) {
       TU_LOG1("HUBFLAG post-final-connection-clear hub=%u port=%u status=%04x change=%04x\r\n",
               _dev0.hub_addr, _dev0.hub_port, port_status.status.value,
               port_status.change.value);
+      // Hub 18 port 4 is the observed failing link on this exact chain.
+      // Test one power-cycle only, after reset/change-flag cleanup; other
+      // ports and all subsequent enumeration attempts remain untouched.
+      if (!downstream_power_cycled && _dev0.hub_addr == 18 &&
+          _dev0.hub_port == 4 && port_status.status.connection &&
+          !port_status.status.port_enable) {
+        downstream_power_cycled = true;
+        TU_LOG1("HUBPOWER begin hub=%u port=%u\r\n", _dev0.hub_addr, _dev0.hub_port);
+        TU_ASSERT(hub_port_clear_feature(_dev0.hub_addr, _dev0.hub_port,
+                                         HUB_FEATURE_PORT_POWER,
+                                         process_enumeration, ENUM_HUB_POWER_OFF), );
+      } else {
+        enum_full_complete();
+      }
+      break;
+    }
+
+    case ENUM_HUB_POWER_OFF:
+      // Distinct from the prior reset-only trials: give a ganged-power hub
+      // time to actually drop its downstream VBUS before sampling.
+      osal_task_delay(350);
+      TU_ASSERT(hub_port_get_status(_dev0.hub_addr, _dev0.hub_port, _usbh_ctrl_buf,
+                                    process_enumeration, ENUM_HUB_POWER_OFF_STATUS), );
+      break;
+
+    case ENUM_HUB_POWER_OFF_STATUS: {
+      hub_port_status_response_t port_status;
+      memcpy(&port_status, _usbh_ctrl_buf, sizeof(port_status));
+      TU_LOG1("HUBPOWER after-off hub=%u port=%u status=%04x change=%04x\r\n",
+              _dev0.hub_addr, _dev0.hub_port, port_status.status.value,
+              port_status.change.value);
+      TU_ASSERT(hub_port_set_feature(_dev0.hub_addr, _dev0.hub_port,
+                                     HUB_FEATURE_PORT_POWER,
+                                     process_enumeration, ENUM_HUB_POWER_ON), );
+      break;
+    }
+
+    case ENUM_HUB_POWER_ON:
+      // bPwrOn2PwrGood on the user's Terminus hubs is 100 ms; wait longer
+      // to allow both active stages to settle before observing the status.
+      osal_task_delay(350);
+      TU_ASSERT(hub_port_get_status(_dev0.hub_addr, _dev0.hub_port, _usbh_ctrl_buf,
+                                    process_enumeration, ENUM_HUB_POWER_ON_STATUS), );
+      break;
+
+    case ENUM_HUB_POWER_ON_STATUS: {
+      hub_port_status_response_t port_status;
+      memcpy(&port_status, _usbh_ctrl_buf, sizeof(port_status));
+      TU_LOG1("HUBPOWER after-on hub=%u port=%u status=%04x change=%04x\r\n",
+              _dev0.hub_addr, _dev0.hub_port, port_status.status.value,
+              port_status.change.value);
+      // Return to the ordinary hub interrupt/change event path for reset.
+      // A second power-cycle is intentionally prohibited until reboot.
       enum_full_complete();
       break;
     }
